{
  "name": "@dokkurator/knowledge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "bin": {
    "dokkurator-knowledge": "./dist/cli.js"
  },
  "scripts": {
    "generate": "mkdir -p src/search/generated && peggy --format es --dts --output src/search/generated/search-query-parser.js src/search/search-query.peggy",
    "prebuild": "pnpm generate",
    "build": "tsc -p tsconfig.json",
    "pretypecheck": "pnpm generate",
    "typecheck": "tsc -p tsconfig.check.json",
    "pretest": "pnpm generate",
    "test": "vitest run",
    "lint": "eslint .",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@dokkurator/doctype": "workspace:*",
    "@dokkurator/index-adapter": "workspace:*",
    "@dokkurator/index-adapter-sqlite": "workspace:*",
    "@dokkurator/source-adapters": "workspace:*",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "peggy": "^5.1.0"
  }
}
