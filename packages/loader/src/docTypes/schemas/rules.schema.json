{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dokkurator.dev/schemas/doctype-rules.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["rules"],
  "properties": {
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "field", "severity"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "field": { "type": "string", "minLength": 1 },
          "severity": { "enum": ["error", "warning"] }
        }
      }
    }
  }
}
