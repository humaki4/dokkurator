{
  "name": "@dokkurator/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "vitest run src",
    "lint": "eslint .",
    "start": "node dist/index.js"
  },
  "bin": {
    "dokkurator": "./dist/index.js"
  },
  "dependencies": {
    "@dokkurator/core": "workspace:*",
    "@dokkurator/config": "workspace:*",
    "@dokkurator/knowledge": "workspace:*",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "yaml": "^2.9.1"
  }
}
