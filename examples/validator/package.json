{
  "name": "@dokkurator/example-validator",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "dokkurator --project minimal validate",
    "demo": "dokkurator --project minimal validate",
    "demo:all": "dokkurator validate",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.check.json",
    "lint": "eslint --config ../../eslint.config.mjs *.mjs *.ts rules minimal/dokkurator.config.mjs",
    "knowledge:index": "dokkurator index",
    "knowledge:search": "dokkurator search",
    "knowledge:diff": "dokkurator diff",
    "demo:json": "dokkurator validate --format json",
    "demo:core": "node validate.mjs"
  },
  "dependencies": {
    "@dokkurator/cli": "workspace:*",
    "@dokkurator/core": "workspace:*"
  },
  "nx": {
    "targets": {
      "test": {
        "dependsOn": [
          "^build"
        ]
      }
    }
  },
  "devDependencies": {
    "@eslint/markdown": "8.0.3"
  }
}
